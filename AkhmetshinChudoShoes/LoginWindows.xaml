<Window x:Class="AkhmetshinChudoShoes.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="300" FontFamily="Calibri" Width="400" Icon="/ProductPhoto/ЧудоОбувь.ico" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Введите логин:" Margin="0,0,0,5"/>
            <TextBox Name="TBoxLogin" Height="30" FontSize="16" Padding="5"/>

            <Button Name="BtnLogin" Content="Войти" Height="40" Margin="0,20,0,0" Click="BtnLogin_Click" FontWeight="Bold"/>

            <Button Name="BtnGuest" Content="Войти как гость" Height="30" Margin="0,10,0,0" Click="BtnGuest_Click" Background="Transparent" BorderBrush="Gray"/>
        </StackPanel>
    </Grid>
</Window>