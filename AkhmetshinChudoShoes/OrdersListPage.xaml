<Page x:Class="AkhmetshinChudoShoes.OrdersListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Список заказов" FontFamily="Calibri" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <TextBlock Text="Список заказов" FontSize="24" FontWeight="Bold" Margin="15,10,0,10" HorizontalAlignment="Left"/>

        <!-- Список заказов -->
        <ListView Name="OrdersListView" Grid.Row="1" HorizontalContentAlignment="Stretch" Margin="10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="Gray" CornerRadius="8" Margin="5" Padding="10" Background="#FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <!-- Информация о заказе -->
                                <ColumnDefinition Width="250"/>
                                <!-- Кнопки -->
                            </Grid.ColumnDefinitions>

                            <!-- Информация -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OrderID, StringFormat={}Заказ № {0}}" FontSize="18" FontWeight="Bold" Foreground="Black"/>
                                <TextBlock Text="{Binding OrderDate, StringFormat={}Дата: {0:dd.MM.yyyy}}" FontSize="16" Foreground="Gray" Margin="0,5,0,0"/>
                                <!-- Выводим ФИО клиента (через навигационное свойство Users) -->
                                <TextBlock Text="{Binding Users.UserLastName, StringFormat={}Клиент: {0}}" FontSize="16" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Users.UserFirstName, StringFormat={}Имя: {0}}" FontSize="16" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Кнопки управления -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <!-- Кнопка просмотра состава -->
                                <Button Content="Состав заказа" Height="30" Margin="0,5" Click="ViewCompositionBtn_Click" Cursor="Hand"/>
                                <!-- Кнопка удаления -->
                                <Button Content="Удалить заказ" Height="30" Margin="0,5" Click="DeleteOrderBtn_Click" Background="Red" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>