<Page x:Class="AkhmetshinChudoShoes.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог обуви" FontFamily="Calibri" IsVisibleChanged="Page_IsVisibleChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Name="FilterPanel" Grid.Row="0" Orientation="Horizontal" Margin="10">
            <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Name="TBoxSearch" Width="180" Height="25" TextChanged="TBoxSearch_TextChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Name="ComboSort" Width="170" Height="25" SelectionChanged="ComboSort_SelectionChanged">
                    <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                    <ComboBoxItem Content="По цене (возр.)"/>
                    <ComboBoxItem Content="По цене (убыв.)"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Фильтр:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Name="ComboFilter" Width="180" Height="25" SelectionChanged="ComboFilter_SelectionChanged"/>
            </StackPanel>
        </WrapPanel>

        <ListView Name="OrderListView" Grid.Row="1" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OrderListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="Black" CornerRadius="8" Margin="10,5" Padding="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                        <Setter Property="Background" Value="#FFB3B3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Изображение товара слева -->
                            <Image Source="{Binding ProductPhoto}" Grid.Column="0" Grid.RowSpan="3" Width="140" Height="140" Stretch="Uniform" Margin="0,0,15,0"/>

                            <!-- Производство | Наименование сверху по центру -->
                            <TextBlock Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} | {1}">
                                        <Binding Path="ManufacturerName"/>
                                        <Binding Path="ProductName"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <!-- Категория, Количество, Состав ниже слева -->
                            <StackPanel Grid.Column="1" Grid.Row="1" Margin="5,10,5,5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CategoryName, StringFormat={}Категория: {0}}" FontSize="17"/>
                                <TextBlock Text="{Binding StockText, StringFormat={}Количество: {0}}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding ProductStructure, StringFormat={}Состав: {0}}" FontSize="17" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Button Name="OrderBtn" Grid.Column="1" Grid.Row="2" Click="OrderBtn_Click" Content="Заказать" Width="120" Height="35" Margin="5,5,0,0" Cursor="Hand" HorizontalAlignment="Left"/>

                            <!-- Цена справа -->
                            <StackPanel Grid.Column="2" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0">
                                <TextBlock Text="{Binding ProductPrice, StringFormat={}{0} руб.}"
                                           TextDecorations="Strikethrough"
                                           Foreground="Gray"
                                           FontSize="16"
                                           HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOrdersLastMonth}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding FinalPrice, StringFormat={}Цена: {0} руб.}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="Red"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>