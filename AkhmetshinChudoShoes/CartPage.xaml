<Page x:Class="AkhmetshinChudoShoes.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Корзина" FontFamily="Calibri" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Корзина" FontSize="24" FontWeight="Bold" Margin="5,0,0,10"/>

        <TextBlock Name="TBlockOrderTarget" Text="" FontSize="16" Foreground="Red" FontWeight="Bold" Margin="5,0,0,10" Visibility="Collapsed"/>

        <DataGrid Name="CartGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" Binding="{Binding StockItem.Products.ProductName}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding StockItem.Sizes.Size}" Width="80"/>

                <DataGridTemplateColumn Header="Кол-во" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="-" Width="25" Height="25" Click="MinusBtn_Click" Cursor="Hand"/>
                                <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold" FontSize="14"/>
                                <Button Content="+" Width="25" Height="25" Click="PlusBtn_Click" Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Цена (руб)" Binding="{Binding StockItem.Products.ProductPrice}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Удалить из корзины" Width="150" Height="35" Margin="0,0,20,0" Click="DeleteFromCartBtn_Click" Background="Red" Cursor="Hand"/>

            <TextBlock Text="Итого: " FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Name="TBlockTotal" Text="0 руб." FontSize="20" FontWeight="Bold" Foreground="Red" VerticalAlignment="Center" Margin="0,0,20,0"/>

            <Button Content="Оформить заказ" Width="150" Height="35" Click="CheckoutBtn_Click" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Page>