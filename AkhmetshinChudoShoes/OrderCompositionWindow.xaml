<Window x:Class="AkhmetshinChudoShoes.OrderCompositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состав заказа" Height="500" Icon="/ProductPhoto/ЧудоОбувь.ico" Width="800" WindowStartupLocation="CenterScreen" FontFamily="Calibri">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Name="TBlockTitle" Text="Состав заказа №" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <DatePicker Name="DatePickerOrder" Width="120" Margin="15,0,0,0" VerticalAlignment="Center" 
                        SelectedDateChanged="DatePickerOrder_SelectedDateChanged"/>
        </StackPanel>

        <DataGrid Name="CompositionGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" Binding="{Binding StockItems.Products.ProductName}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding StockItems.Sizes.Size}" Width="80"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена (руб)" Binding="{Binding StockItems.Products.ProductPrice}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="BtnDeleteItem" Content="Удалить позицию" Width="170" Height="30" Margin="0,0,20,0" 
                    Click="BtnDeleteItem_Click" FontWeight="Bold" Cursor="Hand"/>

            <Button Name="BtnSaveDate" Content="Сохранить дату" Width="150" Height="30" Margin="0,0,20,0" 
                    Click="BtnSaveDate_Click" FontWeight="Bold" 
                    IsEnabled="True" Cursor="Hand"/>

            <TextBlock Text="Итого по заказу: " FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <TextBlock Name="TBlockTotalSum" Text="0 руб." FontSize="18" FontWeight="Bold" Foreground="Red" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>