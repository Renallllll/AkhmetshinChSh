<Page x:Class="AkhmetshinChudoShoes.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Аналитика" FontFamily="Calibri">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Модуль аналитики" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Выбор периода -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Период с:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
            <DatePicker Name="DatePickerStart" Width="150" SelectedDateChanged="DatePicker_SelectedDateChanged"/>

            <TextBlock Text="по:" VerticalAlignment="Center" Margin="20,0,10,0" FontSize="16"/>
            <DatePicker Name="DatePickerEnd" Width="150" SelectedDateChanged="DatePicker_SelectedDateChanged"/>

            <Button Content="Экспорт в PDF" Width="150" Height="30" Margin="30,0,0,0" Click="BtnExportPdf_Click" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>

        <!-- Сводные показатели -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,20,0" Background="#F0F0F0">
                <StackPanel>
                    <TextBlock Text="Всего заказов:" FontSize="16" Foreground="Gray"/>
                    <TextBlock Name="TBlockTotalOrders" Text="0" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="15" Background="#F0F0F0">
                <StackPanel>
                    <TextBlock Text="Сумма продаж (руб):" FontSize="16" Foreground="Gray"/>
                    <TextBlock Name="TBlockTotalSum" Text="0" FontSize="28" FontWeight="Bold" Foreground="Green" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Топ-5 -->
        <TextBlock Grid.Row="3" Text="Топ-5 моделей по количеству проданных пар:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <DataGrid Grid.Row="3" Name="TopProductsGrid" Margin="0,30,0,0" AutoGenerateColumns="False" IsReadOnly="True" 
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding ManufacturerName}" Width="200"/>
                <DataGridTextColumn Header="Кол-во пар" Binding="{Binding TotalQuantity}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>